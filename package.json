{
  "name": "carrerable-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "check:cases": "node scripts/check-case-studies.mjs",
    "check:notes": "node scripts/check-notes.mjs",
    "check:mdx": "node scripts/check-mdx.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:numbers": "node scripts/check-numbers-refs.mjs",
    "build": "astro check && node scripts/check-case-studies.mjs && node scripts/check-notes.mjs && node scripts/check-cv.mjs && astro build",
    "preview": "astro preview",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "test:a11y": "playwright test -c playwright.a11y.config.ts",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/sitemap": "^3.2.0",
    "@fontsource/archivo": "^5.0.0",
    "@fontsource/ibm-plex-mono": "^5.0.0",
    "@fontsource/ibm-plex-sans": "^5.0.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@mdx-js/mdx": "^3.1.1",
    "@playwright/test": "^1.64.1",
    "typescript": "^5.6.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "overrides": {
    "@astrojs/language-server": "2.15.4",
    "lodash": "^4.18.1",
    "yaml": "^2.9.1",
    "braces": "^3.0.3"
  }
}
