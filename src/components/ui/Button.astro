---
// Botón o enlace con aspecto de botón. Variantes: primary (coral) y ghost.
interface Props { href?: string; variant?: 'primary' | 'ghost'; arrow?: boolean; class?: string; type?: 'button' | 'submit'; [k: string]: unknown }
const { href, variant = 'primary', arrow = true, class: cls = '', type = 'button', ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
// Externos y PDF se abren en pestaña nueva: el portafolio nunca se cierra.
const nueva = !!href && (/^https?:\/\//.test(href) || /\.pdf$/i.test(href));
---
<Tag href={href} type={href ? undefined : type} target={nueva ? '_blank' : undefined} rel={nueva ? 'noopener' : undefined} class:list={['btn', `btn-${variant}`, cls]} {...rest}>
  <slot />{arrow && <span class="arrow" aria-hidden="true">→</span>}
</Tag>
