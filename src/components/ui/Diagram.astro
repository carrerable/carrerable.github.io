---
// Incrusta el SVG de arquitectura en línea. Las variables --dg-* se enlazan a los tokens del tema activo
// (--fg, --mut), así que sigue el tema claro/oscuro y el tono de la sección. Las clases del SVG se acotan a .dg
// y los ids se hacen únicos para no chocar con el resto de la página.
import type { Lang } from '../../i18n/ui';
interface Props { name: string; caption: { en: string; es: string }; lang: Lang }
const { name, caption, lang } = Astro.props;
const files = import.meta.glob('../../diagrams/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const raw = files[`../../diagrams/${name}.svg`];
if (!raw) throw new Error(`Diagram: no existe src/diagrams/${name}.svg`);
const cap = caption[lang];
const pre = `dg-${name}-`;
let svg = raw
  .replace(/<title[^>]*>[\s\S]*?<\/title>\s*/, '')
  .replace(/<desc[^>]*>[\s\S]*?<\/desc>\s*/, '')
  .replace(/aria-labelledby="[^"]*"/, `aria-label="${cap.replace(/"/g, '&quot;')}"`)
  .replace(/<style>([\s\S]*?)<\/style>/, (_m, css: string) => {
    const kept = css
      .split('\n')
      .filter((l) => l.trim() && !/:root|@media|^\s*}/.test(l))
      .map((l) => l.replace(/^(\s*)\./, '$1.dg-svg .'));
    return `<style>${kept.join('\n')}</style>`;
  })
  .replace(/id="ah"/g, `id="${pre}ah"`)
  .replace(/url\(#ah\)/g, `url(#${pre}ah)`)
  .replace('<svg ', '<svg class="dg-svg" ');
---
<figure class="dg">
  <div class="dg-scroll" set:html={svg} />
  <figcaption class="mono">{cap}</figcaption>
</figure>

<style is:global>
  .dg { --dg-fg: var(--fg); --dg-mut: var(--mut); --dg-accent: var(--c-coral); --dg-on-accent: var(--c-ink); margin: 0; }
  .dg-scroll { overflow-x: auto; }
  .dg-svg { display: block; width: 100%; min-width: 42rem; height: auto; }
  .dg figcaption { margin-top: var(--s-3); font-size: var(--t-xs); letter-spacing: 0.04em; color: var(--mut); }
</style>
