---
// Embudo: barras centradas, de una sola tonalidad (coral) en pasos de intensidad, con etiqueta y valor escritos.
import ChartFrame from './ChartFrame.astro';
import { fmt, textW, type Lang } from './lib';
interface Props { chart: any; lang: Lang }
const { chart, lang } = Astro.props;
const W = 640, LABEL = 120, VAL = 150, AREA = W - LABEL - VAL, ROW = 46, BAR_H = 24;
const title = chart.title[lang];
const desc = chart.desc[lang];
const stages = chart.data.stages;
const max = stages[0].value;
const tones = [100, 70, 42];
const rows = stages.map((s: any, i: number) => {
  const w = Math.max(6, (s.value / max) * AREA);
  const pct = Math.round((s.value / max) * 100);
  const txt = `${fmt(s.value, lang)} · ${pct}%`;
  return { y: i * ROW, w, x: LABEL + (AREA - w) / 2, s, txt, tone: tones[Math.min(i, tones.length - 1)], tip: `${s.label[lang]}: ${txt}` };
});
const H = stages.length * ROW;
const head = [lang === 'es' ? 'Etapa' : 'Stage', lang === 'es' ? 'Cuentas' : 'Accounts', '%'];
const trows = rows.map((r: any) => [r.s.label[lang], String(r.s.value), `${Math.round((r.s.value / max) * 100)}%`]);
---
<ChartFrame id={chart.id} lang={lang} title={title} desc={desc} source={chart.source[lang]} date={chart.date} head={head} rows={trows}>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby={`t-${chart.id} d-${chart.id}`}>
    <title id={`t-${chart.id}`}>{title}</title>
    <desc id={`d-${chart.id}`}>{desc}</desc>
    {rows.map((r: any) => {
      const tw = textW(r.tip);
      return (
        <g class="mark" tabindex="0" aria-label={r.tip}>
          <text x="0" y={r.y + BAR_H / 2 + 8}>{r.s.label[lang]}</text>
          <rect class="shape" x={r.x} y={r.y + 4} width={r.w} height={BAR_H} rx="4" fill={`color-mix(in srgb, var(--c-coral) ${r.tone}%, var(--bg))`} />
          <text class="big" x={W} y={r.y + BAR_H / 2 + 9} text-anchor="end">{r.txt}</text>
          <g class="tip"><rect x={Math.min(r.x + r.w + 8, W - tw - 4)} y={r.y - 12} width={tw} height="20" rx="4" /><text x={Math.min(r.x + r.w + 8, W - tw - 4) + 8} y={r.y + 2}>{r.tip}</text></g>
        </g>
      );
    })}
  </svg>
</ChartFrame>
