---
import { ui, EMAIL, GITHUB, NAME, PHONE, PHONE_TEL, whatsapp } from '../i18n/ui';
interface Props { lang: 'en' | 'es' }
const { lang } = Astro.props;
const t = ui[lang];
---
<footer class="site-footer">
  <div class="wrap">
    <span class="mono">© 2026 · {NAME}</span>
    <a class="mono" href={PHONE_TEL}>{PHONE}</a>
    <a class="mono" href={whatsapp(lang)} target="_blank" rel="noopener">WhatsApp</a>
    <a class="mono" href={`mailto:${EMAIL}`}>{EMAIL}</a>
    <a class="mono" href={GITHUB} target="_blank" rel="noopener">GitHub</a>
    <a class="mono" href={`/${lang}/how-i-work/#ai`}>{t['footer.ai']}</a>
  </div>
</footer>
