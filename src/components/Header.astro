---
import { ui, NAME } from '../i18n/ui';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ui/ThemeToggle.astro';
interface Props { lang: 'en' | 'es'; path: string }
const { lang, path } = Astro.props;
const t = ui[lang];
const cur = (p: string) => (path === p ? 'page' : undefined);
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href={`/${lang}/`}>{NAME}</a>
    <nav aria-label={lang === 'es' ? 'Principal' : 'Main'}>
      <a href={`/${lang}/projects/`} aria-current={cur(`/${lang}/projects/`)}>{t['nav.projects']}</a>
      <a href={`/${lang}/notes/`} aria-current={cur(`/${lang}/notes/`)}>{t['nav.notes']}</a>
      <a href={`/${lang}/how-i-work/`} aria-current={cur(`/${lang}/how-i-work/`)}>{t['nav.how']}</a>
      <a href={`/${lang}/cv/`} aria-current={cur(`/${lang}/cv/`)}>{t['nav.cv']}</a>
      <a href={`/${lang}/#contact`}>{t['nav.contact']}</a>
      <LangSwitch lang={lang} path={path} />
      <ThemeToggle lang={lang} />
    </nav>
  </div>
</header>
