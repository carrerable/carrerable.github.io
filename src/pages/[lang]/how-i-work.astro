---
import Base from '../../layouts/Base.astro';
import Section from '../../components/ui/Section.astro';
import En from '../../content-pages/how-i-work.en.mdx';
import Es from '../../content-pages/how-i-work.es.mdx';
import { ui, NAME, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'es' } }];
}
const lang = Astro.params.lang as Lang;
const t = ui[lang];
const Content = lang === 'en' ? En : Es;
---
<Base lang={lang} title={`${t['nav.how']} — ${NAME}`} description={t['how.teaser']} path={`/${lang}/how-i-work/`}>
  <Section tone="base" bg="grid">
    <div class="prose">
      <Content />
    </div>
  </Section>
</Base>
