---
import Base from '../layouts/Base.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
---
<Base lang="en" title="Page not found — Luis Carrera" description="Page not found" path="/en/" noindex>
  <Section tone="base" bg="grid">
    <h1>Page not found</h1>
    <p class="row" style="margin-top: var(--s-5)"><Button href="/en/">English</Button> <Button href="/es/" variant="ghost">Español</Button></p>
  </Section>
</Base>
